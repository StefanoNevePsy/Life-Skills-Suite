# Public Firebase web configuration. Never put passwords or admin keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Match the EXISTING namespace to retain access to existing materials.
VITE_WORKSPACE_ID=lifeskills-default
# Leave unset in production. Only demo-* projects may use emulators.
VITE_USE_EMULATORS=false
